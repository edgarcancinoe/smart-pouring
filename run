#!/bin/sh
# One entry point for the project.
#  dataset (real videos -> numbers)
#   ./run calibrate [video ...]        phone lens (default: dataset/data/calibration/*.MOV)
#   ./run track  [A1-0 ...]            mug path from dataset/data/water-pour/<clip>/<clip>.MOV (default: all, parallel)
#   ./run replay [A1-0 ...]            mug follows each tracked pour in the sim: table + videos
#   ./run robot  [A1-0 ...]            the robot carries the mug along each pour: checks + videos
#   ./run watch  [A1-0 ...]            viewer: play the saved robot runs one after another (6 pause, 7/9 prev/next)
#   ./run video  [A1-0 ...]            robot.mp4 for each saved robot run (no re-simulation)
#   ./run export [A1-0 ...]            successful robot runs -> LeRobot dataset for SmolVLA (dataset/data/lerobot/)
#   ./run stats  [A1-0 ...]            success rates + one row per episode -> dataset/data/stats.md
#   ./run upload                       the LeRobot dataset -> Hugging Face Hub

#  policy (SmolVLA, smolvla-finetune/)
#   ./run train  [libero-4 ...]             fine-tune, push to the Hub (CUDA; smolvla-finetune/README.md)
#   ./run eval   [libero-4 ...] [--jobs 2]  models in the sim: 3 plants x 8 spots x N trials -> results/
#   ./run eval-grasp [libero-4 ...] [--jobs 2]  the same trials, ended once the mug is lifted -> results/grasp-n<N>/
#   ./run eval-watch                        one model, live in the MuJoCo viewer
#   ./run compare                           every evaluated model: table + plots

#  recoveries (smolvla-recoveries/)
#   ./run dart   [A1-0 ...] [--jobs 4]      DART: each recording replayed with noise pushes on the way to the mug
#   ./run dart-export                       every saved robot run -> DART dataset -> Hugging Face Hub
#   ./run dart-train                        fine-tune the DART models on it, push to the Hub
#   ./run dagger-check [--jobs 8]           takeover DAgger: the teacher alone must grasp from pushed-off starts
#   ./run dagger       [--jobs 8]           the policy reaches, the teacher takes over when it drifts: takeovers saved
#   ./run dagger-export                     demos + takeovers -> DAgger dataset -> Hugging Face Hub (then ./run train libero-4s-dagger1)

#  memory (smolvla-memory/): models train with ./run train <model>
#   ./run grasp-pos-eval [model ...] [--jobs 8]   grasp-position models in the sim (as ./run eval)
#   ./run relative-eval  [model ...] [--jobs 8]   relative-actions models in the sim (as ./run eval)
#   ./run memory-eval    [model ...] [--jobs 8]   VLM-cache memory models in the sim (as ./run eval)
#   ./run isolated-eval  [model ...] [--jobs 8]   isolated VLM-cache memory models in the sim (as ./run eval)

cd "$(dirname "$0")" || exit 1
export PYTHONPATH=. PYTHONWARNINGS=ignore PYTHONUNBUFFERED=1
py=.venv/bin/python
[ -x "$py" ] || py=python3  # Colab / GPU machine: no uv environment
gl=cgl; [ "$(uname)" = Linux ] && gl=egl  # offscreen rendering: macOS / headless Linux
cmd="$1"; [ $# -gt 0 ] && shift

case "$cmd" in
  calibrate) exec $py dataset/calibration/calibrate.py "$@" ;;
  track)     exec $py dataset/tracking/mug_tracker.py "$@" ;;
  replay)    MUJOCO_GL=$gl exec $py dataset/sim_runs/replay_mug.py "$@" ;;
  robot)     MUJOCO_GL=$gl exec $py dataset/retarget/robot_replay.py "$@" ;;
  watch)     exec .venv/bin/mjpython dataset/sim_runs/playback.py --watch "$@" ;;
  video)     MUJOCO_GL=$gl exec $py dataset/sim_runs/playback.py "$@" ;;
  export)    MUJOCO_GL=$gl exec $py dataset/export_lerobot.py "$@" ;;
  stats)     exec $py dataset/stats.py "$@" ;;
  upload)    exec $py dataset/upload.py "$@" ;;
  train)     PYTHONPATH=.:smolvla-finetune:smolvla-memory/grasp-position:smolvla-memory/VLM-cache exec $py smolvla-finetune/train.py "$@" ;;
  eval)      MUJOCO_GL=$gl exec $py smolvla-finetune/evaluate.py "$@" ;;
  eval-grasp) MUJOCO_GL=$gl exec $py smolvla-finetune/evaluate.py --grasp "$@" ;;
  # cgl: the policy's cameras render offscreen while the viewer window runs (GLFW off the main thread crashes)
  eval-watch) MUJOCO_GL=cgl exec .venv/bin/mjpython smolvla-finetune/eval_watch.py "$@" ;;
  compare)   exec $py smolvla-finetune/compare.py "$@" ;;
  # the recovery scripts import the fine-tuning code (runs, train)
  dart)        PYTHONPATH=.:smolvla-finetune MUJOCO_GL=$gl exec $py smolvla-recoveries/DART/dart.py "$@" ;;
  dart-export) PYTHONPATH=.:smolvla-finetune MUJOCO_GL=$gl exec $py smolvla-recoveries/DART/dart.py --export ;;
  dart-train)  PYTHONPATH=.:smolvla-finetune exec $py smolvla-recoveries/DART/train_dart.py ;;
  dagger)        PYTHONPATH=.:smolvla-finetune MUJOCO_GL=$gl exec $py smolvla-recoveries/DAgger/dagger.py "$@" ;;
  dagger-check)  PYTHONPATH=.:smolvla-finetune MUJOCO_GL=$gl exec $py smolvla-recoveries/DAgger/dagger.py --check "$@" ;;
  dagger-export) PYTHONPATH=.:smolvla-finetune MUJOCO_GL=$gl exec $py smolvla-recoveries/DAgger/dagger.py --export ;;
  grasp-pos-eval) PYTHONPATH=.:smolvla-finetune:smolvla-memory/grasp-position MUJOCO_GL=$gl exec $py smolvla-memory/grasp-position/eval_grasp_position.py "$@" ;;
  relative-eval)  PYTHONPATH=.:smolvla-finetune:smolvla-memory/grasp-position:smolvla-memory/relative-actions MUJOCO_GL=$gl exec $py smolvla-memory/relative-actions/eval_relative.py "$@" ;;
  memory-eval)    PYTHONPATH=.:smolvla-finetune:smolvla-memory/VLM-cache MUJOCO_GL=$gl exec $py smolvla-memory/VLM-cache/eval_memory.py "$@" ;;
  isolated-eval)  PYTHONPATH=.:smolvla-finetune:smolvla-memory/VLM-cache:smolvla-memory/VLM-cache-isolated MUJOCO_GL=$gl exec $py smolvla-memory/VLM-cache-isolated/eval_isolated.py "$@" ;;
  *)         [ -f sim/tools/run ] && . sim/tools/run  # local-only commands, if present (gitignored)
             sed -n '2,33p' "$0" | sed 's/^# //' ;;
esac
